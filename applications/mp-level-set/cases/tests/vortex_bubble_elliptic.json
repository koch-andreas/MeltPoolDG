{
  "$schema": "../parameters.schema.json",
  "base": {
    "case name": "vortex_bubble",
    "dimension": 2,
    "global refinements": 6,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 1
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 2.0,
    "time step size": 0.01
  },
  "output": {
    "paraview": {
      "enable": true,
      "filename": "elliptic_full_p2_DG"
    }
  },
  "level set": {
    "reinitialization": {
      "linear solver": {
        "do matrix free": true,
        "max iterations": 100000,
        "solver type": "CG",
        "preconditioner type": "Diagonal"
      },
      "enable": true,
      "type": "elliptic",
      "elliptic": {
        "penalty parameter": 10000.0,
        "nonlinear solver type": "fixed point",
        "nlsolve": {
          "max nonlinear iterations": 100,
          "residual tolerance": 0.01,
          "residual tolerance alt": 0.1,
          "field correction tolerance": 0.01,
          "field correction tolerance alt": 0.1,
          "verbosity level": 1
        }
      }
    },
    "normal vector": {
      "linear solver": {
        "do matrix free": true
      },
      "filter parameter": 0.5
    },
    "advection diffusion": {
      "linear solver": {
        "do matrix free": true
      }
    }
  }
}
