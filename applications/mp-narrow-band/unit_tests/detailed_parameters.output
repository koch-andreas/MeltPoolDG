{
    "base": {
        "case name": {
            "value": "not_initialized",
            "default_value": "not_initialized",
            "documentation": "Sets the base name for the application that will be fed to the problem type.",
            "pattern": "0",
            "pattern_description": "[Anything]",
            "actions": "0"
        },
        "dimension": {
            "value": "2",
            "default_value": "2",
            "documentation": "Defines the dimension of the problem",
            "pattern": "1",
            "pattern_description": "[Integer]",
            "actions": "1"
        },
        "number": {
            "value": "double",
            "default_value": "double",
            "documentation": "Floating point number format. Currently, only 'double' is explicitely instantiated.",
            "pattern": "2",
            "pattern_description": "[Selection double ]",
            "actions": "2"
        },
        "global refinements": {
            "value": "1",
            "default_value": "1",
            "documentation": "Defines the number of initial global refinements",
            "pattern": "3",
            "pattern_description": "[Integer]",
            "actions": "3"
        },
        "do print parameters": {
            "value": "true",
            "default_value": "true",
            "documentation": "Set this parameter to true to list parameters in output",
            "pattern": "4",
            "pattern_description": "[Bool]",
            "actions": "4"
        },
        "verbosity level": {
            "value": "1",
            "default_value": "1",
            "documentation": "Sets the verbosity level of the console output: 0: silent: for non-robust tests and benchmark runs; 1: minimal: for robust tests; 2: detailed; 3: full",
            "pattern": "5",
            "pattern_description": "[Integer]",
            "actions": "5"
        },
        "fe": {
            "type": {
                "value": "FE_Q",
                "default_value": "FE_Q",
                "documentation": "Finite Element.FE_Q: hexahedral continuous finite element with polynomial degree p; FE_SimplexP: tetrahedral continuous finite element with polynomial degree p; FE_Q_iso_Q1: hexahedral continuous finite element with p subdivisions containing linear elements; FE_DGQ: hexahedral discontinuous finite element with polynomial degree p",
                "pattern": "6",
                "pattern_description": "[Selection not_initialized|FE_Q|FE_SimplexP|FE_Q_iso_Q1|FE_DGQ ]",
                "actions": "6"
            },
            "degree": {
                "value": "1",
                "default_value": "1",
                "documentation": "Defines the degree p of the finite element type. If \"type\" is \"FE_Q_iso_Q1\" this parameter defines the number of subdivisions.",
                "pattern": "7",
                "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                "actions": "7"
            }
        }
    },
    "time stepping": {
        "start time": {
            "value": "0",
            "default_value": "0",
            "documentation": "Defines the start time for the solution of the levelset problem",
            "pattern": "8",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "8"
        },
        "end time": {
            "value": "1",
            "default_value": "1",
            "documentation": "Sets the end time for the solution of the levelset problem",
            "pattern": "9",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "9"
        },
        "time step size": {
            "value": "0.01",
            "default_value": "0.01",
            "documentation": "Sets the step size for time stepping. For non-uniform time stepping, this parameter determines the size of the first time step.",
            "pattern": "10",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "10"
        },
        "max n steps": {
            "value": "10000000",
            "default_value": "10000000",
            "documentation": "Sets the maximum number of melt_pool steps",
            "pattern": "11",
            "pattern_description": "[Integer]",
            "actions": "11"
        },
        "time step size function": {
            "value": "0.0*t",
            "default_value": "0.0*t",
            "documentation": "Set an analytical function to determine the time step size. For the prediction of the new time increment, the old time is used.",
            "pattern": "12",
            "pattern_description": "[Anything]",
            "actions": "12"
        }
    },
    "narrow band": {
        "type": {
            "value": "extension",
            "default_value": "extension",
            "documentation": "Type of the narrow band. extension: the band consists of the cut cells and their face neighbors; the level set of the neighbor cells is reconstructed by the extension from the cut cells in every time step. advected_layers: the band consists of the cut cells and several layers of vertex neighbors, which are advected together with the cut cells; the level set of the layers is only reconstructed by geometric redistancing (closest point on the discrete interface of the cut cells) for newly added cells and after the elliptic reinitialization of the cut cells. semi_lagrangian: the level set is only stored on the cut cells; in each time step, it is evaluated on the cut cells and their vertex neighbors (candidate cells) by nodal interpolation of the back-traced level set (foot point of the characteristic in a cut cell: polynomial of the cut cell; otherwise: distance to the discrete interface with the sign of the cell containing the foot point). The new cut cells are determined from the candidate cells; no extension is needed. Requires a displacement below one cell per time step.",
            "pattern": "13",
            "pattern_description": "[Selection extension|advected_layers|semi_lagrangian ]",
            "actions": "13"
        },
        "number of layers": {
            "value": "2",
            "default_value": "2",
            "documentation": "Number of layers of vertex neighbors around the cut cells (advected_layers).",
            "pattern": "14",
            "pattern_description": "[Integer range 2...2147483647 (inclusive)]",
            "actions": "14"
        },
        "extension": {
            "type": {
                "value": "ghost_penalty",
                "default_value": "ghost_penalty",
                "documentation": "Type of the extension of the level-set field from the cut cells to the neighbor cells: global face-based ghost-penalty extension (ghost_penalty) or closest-point extension (closest_point), where the level set at the nodes of the neighbor cells is given by the first-order Taylor expansion phi(y) + grad phi(y) . (x - y) from the closest point y on the discrete interface of the cut cells.",
                "pattern": "15",
                "pattern_description": "[Selection ghost_penalty|closest_point ]",
                "actions": "15"
            },
            "ghost penalty parameters": {
                "value": "100, 1",
                "default_value": "100, 1",
                "documentation": "Dimensionless ghost-penalty parameters gamma_k > 0 for the jumps of the k-th normal derivative (k = 0, ..., p) on the ghost-penalty faces, which are scaled by h^(2k+1). Specify comma-separated values starting with k = 0. If less than p+1 values are given, the last value is used for all remaining k.",
                "pattern": "16",
                "pattern_description": "[List of <[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]> of length 0...4294967295 (inclusive)]",
                "actions": "16"
            },
            "ghost penalty faces": {
                "value": "all_band_faces",
                "default_value": "all_band_faces",
                "documentation": "Set of faces on which the ghost-penalty terms of the extension are evaluated (ghost-penalty extension).",
                "pattern": "17",
                "pattern_description": "[Selection all_band_faces|cut_cell_faces ]",
                "actions": "17"
            },
            "sign limiter tolerance": {
                "value": "0.05",
                "default_value": "0.05",
                "documentation": "Tolerance of the sign limiter for the extended level-set field on the neighbor cells, relative to the cell size h. If the extended level set attains values of the opposite sign of its cell mean with a magnitude larger than tolerance * h in a neighbor cell, its deviation from the cell mean is scaled such that it does not change its sign. Neighbor cells do not contain the interface by definition; spurious zero crossings, e.g., due to the polynomial extrapolation near under-resolved interface tips, would otherwise create spurious cut cells. Set to a negative value to disable the limiter.",
                "pattern": "18",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "18"
            },
            "sign clamp epsilon": {
                "value": "0",
                "default_value": "0",
                "documentation": "Sign clamp of the extrapolated level set (extension and geometric redistancing): each extended cell is assigned to the side of the interface, on which it is located (from the traces of the adjacent cut cells or from the closest point on the interface). Nodal values of the opposite sign (or zero) are set to -epsilon * h on the negative side and to +epsilon * h on the positive side (h: cell size), such that extrapolated values never introduce a new interface. The sign clamp is applied after the sign limiter. Set to 0 to disable the sign clamp.",
                "pattern": "19",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "19"
            },
            "minimum source volume fraction": {
                "value": "0",
                "default_value": "0",
                "documentation": "Minimum volume fraction |K cap {phi > 0}| \/ |K| of the positive phase of a cut cell K, for which K serves as source of the extension. Ghost-penalty extension: the ghost-penalty faces between cut cells with a smaller volume fraction and neighbor cells are not evaluated, i.e., the neighbor cells are extended from the other cut cells via the faces to these cut cells and to other neighbor cells (if the ghost-penalty faces include all band faces). If a neighbor cell is not connected to a cut cell with a sufficient volume fraction, its faces to the small cut cells are kept. Closest-point extension: small cut cells are only considered in the closest-point search, if no other cut cells share a vertex with the neighbor cell. In contrast to 'neighbor activation volume fraction', all neighbor cells remain active. Set to 0 to use all cut cells as sources.",
                "pattern": "20",
                "pattern_description": "[Double 0...1 (inclusive)]",
                "actions": "20"
            },
            "linear solver": {
                "solver type": {
                    "value": "CG",
                    "default_value": "CG",
                    "documentation": "Set this parameter for choosing an iterative linear solver type.",
                    "pattern": "21",
                    "pattern_description": "[Selection CG|GMRES ]",
                    "actions": "21"
                },
                "preconditioner type": {
                    "value": "ILU",
                    "default_value": "ILU",
                    "documentation": "Set this parameter for choosing a preconditioner type.",
                    "pattern": "22",
                    "pattern_description": "[Selection Identity|AMG|ILU|Diagonal ]",
                    "actions": "22"
                },
                "max iterations": {
                    "value": "1000",
                    "default_value": "1000",
                    "documentation": "Set the maximum number of iterations for solving the linear system of equations.",
                    "pattern": "23",
                    "pattern_description": "[Integer]",
                    "actions": "23"
                },
                "rel tolerance": {
                    "value": "1e-12",
                    "default_value": "1e-12",
                    "documentation": "Set the relative tolerance for a successful solution of the linear system of equations.",
                    "pattern": "24",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "24"
                },
                "abs tolerance": {
                    "value": "1e-20",
                    "default_value": "1e-20",
                    "documentation": "Set the absolute tolerance for a successful solution of the linear system of equations.",
                    "pattern": "25",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "25"
                },
                "do matrix free": {
                    "value": "false",
                    "default_value": "false",
                    "documentation": "Set this parameter if a matrix free solution procedure should be performed.",
                    "pattern": "26",
                    "pattern_description": "[Bool]",
                    "actions": "26"
                },
                "monitor type": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Set the monitor type of the linear solver.",
                    "pattern": "27",
                    "pattern_description": "[Selection none|reduced|all ]",
                    "actions": "27"
                }
            }
        },
        "advection": {
            "time integration": {
                "type": {
                    "value": "SSP_RK_stage_3_order_3",
                    "default_value": "SSP_RK_stage_3_order_3",
                    "documentation": "Name of the time integration scheme.",
                    "pattern": "28",
                    "pattern_description": "[Selection not_initialized|LSRK_stage_1_order_1|LSRK_stage_3_order_3|LSRK_stage_5_order_4|LSRK_stage_7_order_4|LSRK_stage_9_order_5|RKC_n_stages|SSP_RK_stage_1_order_1|SSP_RK_stage_2_order_2|SSP_RK_stage_3_order_3|implicit_euler|explicit_euler|crank_nicolson|bdf_1|bdf_2|bdf_3|bdf_4|bdf_5|bdf_6|imex ]",
                    "actions": "28"
                },
                "preconditioner update frequency": {
                    "value": "100",
                    "default_value": "100",
                    "documentation": "Frequency at which the preconditioner gets updated.",
                    "pattern": "29",
                    "pattern_description": "[Integer]",
                    "actions": "29"
                },
                "RKC n stages": {
                    "value": "5",
                    "default_value": "5",
                    "documentation": "Number of stages for the RKC scheme.",
                    "pattern": "30",
                    "pattern_description": "[Integer]",
                    "actions": "30"
                },
                "epsilon": {
                    "value": "0.153846",
                    "default_value": "0.153846",
                    "documentation": "Damping parameter for the RKC scheme.",
                    "pattern": "31",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "31"
                },
                "nlsolve": {
                    "max nonlinear iterations": {
                        "value": "10",
                        "default_value": "10",
                        "documentation": "Set the number of maximum nonlinear iterations with standard tolerances.",
                        "pattern": "32",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "32"
                    },
                    "field correction tolerance": {
                        "value": "1e-10",
                        "default_value": "1e-10",
                        "documentation": "Set the tolerance for the maximum allowed correction of the unknown field.",
                        "pattern": "33",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "33"
                    },
                    "residual tolerance": {
                        "value": "1e-09",
                        "default_value": "1e-09",
                        "documentation": "Set the tolerance for the maximum allowed residual of the nonlinear system.",
                        "pattern": "34",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "34"
                    },
                    "max nonlinear iterations alt": {
                        "value": "0",
                        "default_value": "0",
                        "documentation": "Set the number of maximum nonlinear iterations with alternative tolerances.",
                        "pattern": "35",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "35"
                    },
                    "field correction tolerance alt": {
                        "value": "1e-09",
                        "default_value": "1e-09",
                        "documentation": "Set the alternative tolerance for the maximum allowed correction of the unknown field.",
                        "pattern": "36",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "36"
                    },
                    "residual tolerance alt": {
                        "value": "1e-08",
                        "default_value": "1e-08",
                        "documentation": "Set the alternative tolerance for the maximum allowed residual of the nonlinear system.",
                        "pattern": "37",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "37"
                    },
                    "use relative tolerances": {
                        "value": "false",
                        "default_value": "false",
                        "documentation": "Set to true to interpret the residual tolerances relative to the norm of the initial residual and the field correction tolerances relative to the norm of the current solution. If the respective reference norm is zero, the tolerance is applied as an absolute value.",
                        "pattern": "38",
                        "pattern_description": "[Bool]",
                        "actions": "38"
                    },
                    "verbosity level": {
                        "value": "-1",
                        "default_value": "-1",
                        "documentation": "Set to one for detailed solver output.",
                        "pattern": "39",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "39"
                    }
                },
                "linear solver": {
                    "solver type": {
                        "value": "GMRES",
                        "default_value": "GMRES",
                        "documentation": "Set this parameter for choosing an iterative linear solver type.",
                        "pattern": "40",
                        "pattern_description": "[Selection CG|GMRES ]",
                        "actions": "40"
                    },
                    "preconditioner type": {
                        "value": "Identity",
                        "default_value": "Identity",
                        "documentation": "Set this parameter for choosing a preconditioner type.",
                        "pattern": "41",
                        "pattern_description": "[Selection Identity|AMG|ILU|Diagonal ]",
                        "actions": "41"
                    },
                    "max iterations": {
                        "value": "10000",
                        "default_value": "10000",
                        "documentation": "Set the maximum number of iterations for solving the linear system of equations.",
                        "pattern": "42",
                        "pattern_description": "[Integer]",
                        "actions": "42"
                    },
                    "rel tolerance": {
                        "value": "1e-12",
                        "default_value": "1e-12",
                        "documentation": "Set the relative tolerance for a successful solution of the linear system of equations.",
                        "pattern": "43",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "43"
                    },
                    "abs tolerance": {
                        "value": "1e-20",
                        "default_value": "1e-20",
                        "documentation": "Set the absolute tolerance for a successful solution of the linear system of equations.",
                        "pattern": "44",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "44"
                    },
                    "do matrix free": {
                        "value": "true",
                        "default_value": "true",
                        "documentation": "Set this parameter if a matrix free solution procedure should be performed.",
                        "pattern": "45",
                        "pattern_description": "[Bool]",
                        "actions": "45"
                    },
                    "monitor type": {
                        "value": "none",
                        "default_value": "none",
                        "documentation": "Set the monitor type of the linear solver.",
                        "pattern": "46",
                        "pattern_description": "[Selection none|reduced|all ]",
                        "actions": "46"
                    }
                }
            },
            "velocity": {
                "value": "bulk",
                "default_value": "bulk",
                "documentation": "Velocity of the DG advection on the narrow band: the given velocity u (bulk) or the extension velocity u(y(x)) (extension), i.e., the given velocity at the closest point y(x) = x - phi grad phi \/ |grad phi|^2 on the zero level set, evaluated with the current level set at each stage of the time integration (on faces with the averages of the traces; |grad phi| is bounded from below by 0.5). The extension velocity is constant along the normals of the interface and keeps the level set of the band a signed distance, while the interface moves with u. Not available for the semi-Lagrangian band.",
                "pattern": "47",
                "pattern_description": "[Selection bulk|extension ]",
                "actions": "47"
            },
            "artificial viscosity": {
                "factor": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Artificial viscosity of the advection in the cells flagged by the modal smoothness indicator of Persson & Peraire (2006): the term div(epsilon grad phi) is added to the advection equation (SIPG discretization on the band, natural boundary condition at the outer boundary of the band). The viscosity is constant per cell and determined at the beginning of each time step from the indicator S = log10(E_p \/ E_var), where E_p is the energy of the highest Legendre modes (degree p in any direction) and E_var the energy of all modes except the cell mean: epsilon = epsilon_0 for S > s_0 + kappa, epsilon = epsilon_0 \/ 2 (1 + sin(pi (S - s_0) \/ (2 kappa))) for |S - s_0| <= kappa and zero otherwise, with epsilon_0 = factor h max |u| \/ p (h: cell size, max |u| over the cell) and s_0 = -4 log10(p) + offset. The viscous term is integrated explicitly, i.e., large factors violate the stability limit of the explicit time integration (the maximum diffusion number epsilon dt \/ h^2 is printed for verbosity level 1). A factor of zero disables the artificial viscosity. Requires p >= 2.",
                    "pattern": "48",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "48"
                },
                "indicator offset": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Offset of the threshold s_0 = -4 log10(p) + offset of the smoothness indicator.",
                    "pattern": "49",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "49"
                },
                "indicator width": {
                    "value": "0.5",
                    "default_value": "0.5",
                    "documentation": "Half width kappa of the transition of the viscosity around the threshold s_0.",
                    "pattern": "50",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "50"
                },
                "cells": {
                    "value": "all_band_cells",
                    "default_value": "all_band_cells",
                    "documentation": "Cells, in which the artificial viscosity is applied: all cells of the band (all_band_cells) or all cells of the band, which are not cut at the beginning of the time step (non_cut_cells).",
                    "pattern": "51",
                    "pattern_description": "[Selection all_band_cells|non_cut_cells ]",
                    "actions": "51"
                }
            },
            "limiter": {
                "cells": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Bound-preserving limiter of the advection: after each stage of the SSP Runge-Kutta scheme, the level set of the limited cells is scaled around its cell mean, such that its values at the Gauss-Lobatto points remain within the bounds given by the minimum m and maximum M of the level set at the beginning of the time step on the domain of dependence of the cell. none: no limiter; all_band_cells: all cells of the band; non_cut_cells: all cells of the band, which are not cut at the beginning of the time step.",
                    "pattern": "52",
                    "pattern_description": "[Selection none|all_band_cells|non_cut_cells ]",
                    "actions": "52"
                },
                "type": {
                    "value": "sign",
                    "default_value": "sign",
                    "documentation": "Type of the bounds. maximum_principle: local maximum principle [m - r h, M + r h]; cells with an inflow face to an inactive cell or at the boundary of the domain are not limited (unknown domain of dependence). sign: cells, whose domain of dependence has a definite sign, keep this sign, i.e., phi >= min(m, epsilon h) if m > 0 and phi <= max(M, -epsilon h) if M < 0; cells with values of both signs in their domain of dependence are not limited; inactive cells and the boundary of the domain have the sign of the adjacent band cell. In contrast to the sign preservation, the local maximum principle also clips smooth extrema of the level set (e.g., the ridge of a thin filament).",
                    "pattern": "53",
                    "pattern_description": "[Selection maximum_principle|sign ]",
                    "actions": "53"
                },
                "bounds": {
                    "value": "upwind_strips",
                    "default_value": "upwind_strips",
                    "documentation": "Approximation of the domain of dependence of a cell: the cell and all its face neighbors in the band (face_neighbors), the cell and its face neighbors in the band across inflow faces (upwind_face_neighbors), or the cell and the strips of width |u.n| dt of the face neighbors in the band along the inflow faces, which are extended by |u| dt beyond the edges of the faces (upwind_strips).",
                    "pattern": "54",
                    "pattern_description": "[Selection face_neighbors|upwind_face_neighbors|upwind_strips ]",
                    "actions": "54"
                },
                "relaxation": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Relaxation r of the bounds of the local maximum principle relative to the cell size h: [m - r h, M + r h].",
                    "pattern": "55",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "55"
                },
                "sign epsilon": {
                    "value": "0.01",
                    "default_value": "0.01",
                    "documentation": "Minimum distance epsilon h of the level set from zero (relative to the cell size h), which is enforced by the sign-preserving limiter, unless the domain of dependence attains values closer to zero.",
                    "pattern": "56",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "56"
                }
            }
        },
        "neighbor activation": {
            "value": "all_face_neighbors",
            "default_value": "all_face_neighbors",
            "documentation": "Face neighbors of the cut cells, which are activated as neighbor cells of the band (extension band). all_face_neighbors: all face neighbors; downstream_face_neighbors: only the face neighbors, into which the velocity points across a face shared with a cut cell (at any Gauss-Lobatto point of the face at the beginning or the end of the next time step), i.e., the cells into which the interface can move. The level set is only extended to these cells. At the faces of the cut cells to inactive upstream cells, the upwind flux uses the interior trace of the cut cell, i.e., the cut cell is not influenced by extrapolated values from upstream.",
            "pattern": "57",
            "pattern_description": "[Selection all_face_neighbors|downstream_face_neighbors ]",
            "actions": "57"
        },
        "neighbor activation volume fraction": {
            "value": "0",
            "default_value": "0",
            "documentation": "Minimum volume fraction |K cap {phi > 0}| \/ |K| of the positive phase of a cut cell K, for which its face neighbors are activated as neighbor cells of the narrow band (and filled by the extension). Face neighbors of cut cells with a smaller volume fraction remain inactive (FE_Nothing), unless they are face neighbors of another cut cell with a sufficient volume fraction. Set to 0 to activate all face neighbors of the cut cells.",
            "pattern": "58",
            "pattern_description": "[Double 0...1 (inclusive)]",
            "actions": "58"
        },
        "reinitialization faces": {
            "value": "cut_cell_faces",
            "default_value": "cut_cell_faces",
            "documentation": "Set of faces on which the SIPG terms of the elliptic reinitialization on the cut cells are evaluated: all faces between two cut cells (cut_cell_faces) or only the faces between two cut cells, which are crossed by the interface (interface_faces). In the latter case, the cut cells are only coupled across the faces crossed by the interface.",
            "pattern": "59",
            "pattern_description": "[Selection cut_cell_faces|interface_faces ]",
            "actions": "59"
        },
        "reinitialization interface": {
            "value": "zero_level_set",
            "default_value": "zero_level_set",
            "documentation": "Interface, at which the reinitialization on the cut cells enforces phi = 0 weakly by the interface penalty term: the zero level set of the level set before the reinitialization (zero_level_set) or points of the interface (advected_points), which are seeded on the initial zero level set (Gauss points of the surface quadrature) and advected with the velocity (classical fourth-order Runge-Kutta method, weights and normal vectors by Nanson's formula) independently of the interpolation of the level set (front tracking). Points outside of the band or with |phi| > 0.2 h are removed, the quadrature points of the zero level set of the advected level set phi, whose distance to all points exceeds h \/ (p+1), are added, and in cells with more than 2 (p+1)^(dim-1) points, the closest points are merged. Points with a point of opposite orientation closer than 2 h (under-resolved interface) are not used. The cut cells are determined from phi; in cut cells without usable points, the zero level set of phi is used. The factors 0.2 and 2 are set in the subsection 'advected points'.",
            "pattern": "60",
            "pattern_description": "[Selection zero_level_set|advected_points ]",
            "actions": "60"
        },
        "reinitialization frequency": {
            "value": "1",
            "default_value": "1",
            "documentation": "Reinitialize the level-set field on the cut cells every n-th time step. Set to 0 to disable the frequency-based reinitialization.",
            "pattern": "61",
            "pattern_description": "[Integer]",
            "actions": "61"
        },
        "reinitialization eikonal threshold": {
            "value": "0",
            "default_value": "0",
            "documentation": "Reinitialize the level-set field on the cut cells, if the eikonal error sqrt(int (|grad phi| - 1)^2 dx \/ V) on the cut cells exceeds this value. Set to 0 to disable the error-based reinitialization.",
            "pattern": "62",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "62"
        },
        "advected points": {
            "unresolved distance": {
                "value": "2",
                "default_value": "2",
                "documentation": "Distance relative to the cell size, below which advected interface points of opposite orientation are not used in the reinitialization (unresolved interface, e.g., both sides of a thin filament); the treatment of the cells around them is set by 'unresolved cells'. Only used for reinitialization interface = advected_points.",
                "pattern": "63",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "63"
            },
            "support tolerance": {
                "value": "0.2",
                "default_value": "0.2",
                "documentation": "Advected interface points, at which the magnitude of the advected level set exceeds this value times the cell size, are removed (parts of the interface, which the level set has lost). Only used for reinitialization interface = advected_points.",
                "pattern": "64",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "64"
            },
            "unresolved cells": {
                "value": "zero_level_set",
                "default_value": "zero_level_set",
                "documentation": "Treatment of the cut cells, which contain unresolved points or are closer than 'subcell buffer' times the cell size to an unresolved point. zero_level_set: the reinitialization uses the zero level set of the advected level set in the cut cells without usable points (and only the usable points in the other cut cells). subcell_distance: after the reinitialization, the level set of these cells is replaced by the L2-projection of the signed distance to the advected points (all points, evaluated at the points of an iterated Gauss quadrature with 'subcell subdivisions' subdivisions per direction; each point represents a flat patch of its weight with its normal vector), i.e., the reinitialization of these cells is replaced by an exact redistancing at the subcell scale, whose result is projected onto the polynomials of the cells. Beyond the edges of the patches (e.g., the open end of a chain of points), the signed distance takes the sign of the advected level set, and a cell keeps the reinitialized level set, if the signed distance has a different sign than the advected level set at a quadrature point farther than a quarter of the cell size from the points (the points do not create new parts of the interface). Only used for reinitialization interface = advected_points.",
                "pattern": "65",
                "pattern_description": "[Selection zero_level_set|subcell_distance ]",
                "actions": "65"
            },
            "subcell buffer": {
                "value": "1",
                "default_value": "1",
                "documentation": "Distance relative to the cell size, within which the cut cells around unresolved points are treated as unresolved cells.",
                "pattern": "66",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "66"
            },
            "subcell subdivisions": {
                "value": "4",
                "default_value": "4",
                "documentation": "Number of subdivisions per direction of the iterated Gauss quadrature of the L2-projection of the subcell distance.",
                "pattern": "67",
                "pattern_description": "[Integer range 1...2147483647 (inclusive)]",
                "actions": "67"
            }
        },
        "continuous level set": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Compute a continuous level-set field psi on the cut cells (FE_Q of the same degree, continuous across the faces between cut cells) after each time step by the constrained L2-projection of the DG level set phi: (psi, w) + sum_K gamma_K (psi, w)_{Gamma cap K} = (phi, w) on the cut cells, where Gamma is the zero level set of phi. The normal vector (projection of grad psi, normalized at the nodes) and the curvature (projection of -div n) are computed from psi with the filter parameters and linear solvers of the subsections 'normal vector' and 'curvature'. A filter parameter of zero is recommended: the damping biases the normal vector and the curvature on the thin band of cut cells independently of the mesh size. The fields are written to the output as level_set_cg, normal and curvature. The continuous level set does not feed back into the DG level set.",
                "pattern": "68",
                "pattern_description": "[Bool]",
                "actions": "68"
            },
            "interface penalty": {
                "value": "100",
                "default_value": "100",
                "documentation": "Dimensionless factor c of the interface penalty gamma_K = c h_K (h_K: cell size), which pins the zero level set of the continuous level set to the zero level set of the DG level set in a least-squares sense. Since the DG level set is discontinuous, the interface may still move; the maximum shift is printed for verbosity level 1. Set to 0 for the plain L2-projection.",
                "pattern": "69",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "69"
            },
            "linear solver": {
                "solver type": {
                    "value": "CG",
                    "default_value": "CG",
                    "documentation": "Set this parameter for choosing an iterative linear solver type.",
                    "pattern": "70",
                    "pattern_description": "[Selection CG|GMRES ]",
                    "actions": "70"
                },
                "preconditioner type": {
                    "value": "ILU",
                    "default_value": "ILU",
                    "documentation": "Set this parameter for choosing a preconditioner type.",
                    "pattern": "71",
                    "pattern_description": "[Selection Identity|AMG|ILU|Diagonal ]",
                    "actions": "71"
                },
                "max iterations": {
                    "value": "1000",
                    "default_value": "1000",
                    "documentation": "Set the maximum number of iterations for solving the linear system of equations.",
                    "pattern": "72",
                    "pattern_description": "[Integer]",
                    "actions": "72"
                },
                "rel tolerance": {
                    "value": "1e-12",
                    "default_value": "1e-12",
                    "documentation": "Set the relative tolerance for a successful solution of the linear system of equations.",
                    "pattern": "73",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "73"
                },
                "abs tolerance": {
                    "value": "1e-20",
                    "default_value": "1e-20",
                    "documentation": "Set the absolute tolerance for a successful solution of the linear system of equations.",
                    "pattern": "74",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "74"
                },
                "do matrix free": {
                    "value": "true",
                    "default_value": "true",
                    "documentation": "Set this parameter if a matrix free solution procedure should be performed.",
                    "pattern": "75",
                    "pattern_description": "[Bool]",
                    "actions": "75"
                },
                "monitor type": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Set the monitor type of the linear solver.",
                    "pattern": "76",
                    "pattern_description": "[Selection none|reduced|all ]",
                    "actions": "76"
                }
            }
        }
    },
