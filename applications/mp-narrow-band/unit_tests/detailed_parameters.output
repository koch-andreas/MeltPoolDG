    "output": {
        "directory": {
            "value": ".\/",
            "default_value": ".\/",
            "documentation": "Sets the base directory for all output.",
            "pattern": "188",
            "pattern_description": "[Anything]",
            "actions": "188"
        },
        "write frequency": {
            "value": "1",
            "default_value": "1",
