                "pattern_description": "[Bool]",
                "actions": "198"
            },
            "write higher order cells": {
                "value": "true",
                "default_value": "true",
                "documentation": "Set this parameter to false to write bi- or trilinear data only. Set this parameter to true to write higher order cell data. Note: higher order cell data can only be written for hexahedron meshes and 2 or 3 dimensions.",
                "pattern": "199",
                "pattern_description": "[Bool]",
                "actions": "199"
            },
            "n groups": {
                "value": "1",
                "default_value": "1",
                "documentation": "Number of parallel written vtu-files.",
                "pattern": "200",
                "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                "actions": "200"
            },
            "n patches": {
                "value": "0",
                "default_value": "0",
                "documentation": "Control number of patches to enable high-order.",
                "pattern": "201",
                "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                "actions": "201"
            }
        },
        "particles": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Set this parameter to true to activate particle paraview output.",
                "pattern": "202",
                "pattern_description": "[Bool]",
                "actions": "202"
            },
            "filename": {
                "value": "particle",
                "default_value": "particle",
                "documentation": "Sets the base name for particle output files.",
                "pattern": "203",
                "pattern_description": "[Anything]",
                "actions": "203"
            }
        },
        "stages": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Write the level set on the cut cells (level_set) and on the band (level_set_band) at the beginning of each time step (stage 0: band after the extension or the redistancing, which is the initial value of the advection) and after each stage of the explicit Runge-Kutta scheme of the advection (stages 1, ..., S; the last stage is the advected level set before the update of the band, the reinitialization and the extension). The files <paraview filename>_stages_<time step>_<stage>.vtu are written to the output directory, where <time step> is the number of the time step, whose regular output is <paraview filename>_<time step>. In <paraview filename>_stages.pvd, stage s of the time step from t^n to t^n + dt is assigned the time t^n + s \/ (s + 1) dt, such that the stages are ordered between the regular outputs.",
                "pattern": "204",
                "pattern_description": "[Bool]",
                "actions": "204"
            },
            "start time": {
                "value": "-1.79769e+308",
                "default_value": "-1.79769e+308",
                "documentation": "Only the time steps, which start at t^n >= start time, are written.",
                "pattern": "205",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "205"
            },
            "end time": {
                "value": "1.79769e+308",
                "default_value": "1.79769e+308",
                "documentation": "Only the time steps, which start at t^n <= end time, are written.",
                "pattern": "206",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "206"
            }
        }
    },
    "profiling": {
        "verbosity": {
            "value": "none",
            "default_value": "none",
            "documentation": "Sets the verbosity of the profiling information to be collected. If set to 'none', no profiling information is collected. If set to 'basic', only data which is cheap to collect is recorded. If set to 'detailed', also data which is expensive to collect is recorded. It is recommended to enable detailed profiling only when necessary for in-depth analysis or debugging purposes.",
