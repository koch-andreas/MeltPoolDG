        "stages": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Write the level set on the cut cells (level_set) and on the band (level_set_band) at the beginning of each time step (stage 0: band after the extension or the redistancing, which is the initial value of the advection) and after each stage of the explicit Runge-Kutta scheme of the advection (stages 1, ..., S; the last stage is the advected level set before the update of the band, the reinitialization and the extension). The files <paraview filename>_stages_<time step>_<stage>.vtu are written to the output directory, where <time step> is the number of the time step, whose regular output is <paraview filename>_<time step>. In <paraview filename>_stages.pvd, stage s of the time step from t^n to t^n + dt is assigned the time t^n + s \/ (s + 1) dt, such that the stages are ordered between the regular outputs.",
                "pattern": "178",
                "pattern_description": "[Bool]",
                "actions": "178"
            },
            "start time": {
                "value": "-1.79769e+308",
                "default_value": "-1.79769e+308",
                "documentation": "Only the time steps, which start at t^n >= start time, are written.",
                "pattern": "179",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "179"
            },
            "end time": {
                "value": "1.79769e+308",
                "default_value": "1.79769e+308",
                "documentation": "Only the time steps, which start at t^n <= end time, are written.",
                "pattern": "180",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "180"
            }
        }
