            "actions": "215"
        },
        "max wall time": {
            "value": "0",
            "default_value": "0",
            "documentation": "Maximum wall-clock time in seconds (zero: no limit). After the first time step, at whose end the elapsed wall-clock time exceeds this value, the restart files are written and the simulation stops, such that it can be continued with 'load' = 0. Set it to the time limit of the job minus a margin for the last time step and for writing the restart files. Requires 'save' >= 0.",
            "pattern": "216",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "216"
        }
    }
