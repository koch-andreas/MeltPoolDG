                    "pattern": "94",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "94"
                }
            },
            "Continuous Galerkin": {
                "implementation": {
                    "value": "meltpooldg",
                    "default_value": "meltpooldg",
                    "documentation": "Choose the corresponding implementation of the reinitialization operation.",
                    "pattern": "95",
                    "pattern_description": "[Selection meltpooldg|adaflo ]",
                    "actions": "95"
                },
                "tangential diffusion factor": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Factor that multiplies the normal diffusion factor, i.e., the diffusion length, to obtain the diffusion factor in the tangential direction.",
                    "pattern": "96",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "96"
                },
                "interface constraint type": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Technique to enforce the initial position of the zero level-set iso-surface during the reinitialization. none: no enforcement. surface_penalty: penalty term integrated over the interface, scaled by the interface penalty parameter. dirichlet: the DoFs of all cells intersected by the interface are fixed by Dirichlet constraints.",
                    "pattern": "97",
                    "pattern_description": "[Selection none|surface_penalty|dirichlet ]",
                    "actions": "97"
                },
                "interface penalty parameter": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Dimensionless penalty factor for the weak enforcement of the initial position of the zero level-set iso-surface during the reinitialization. It is scaled by h\/dtau, with the cell size h and the pseudo-time step dtau, to obtain the penalty coefficient. Only used for the interface constraint type surface_penalty.",
                    "pattern": "98",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "98"
                }
            },
            "Discontinuous Galerkin": {
                "factor diffusivity": {
                    "value": "0.25",
                    "default_value": "0.25",
                    "documentation": "Set the factor for diffusivity.",
                    "pattern": "99",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "99"
                },
                "IP diffusion": {
