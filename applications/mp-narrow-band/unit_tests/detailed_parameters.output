{
    "base": {
        "case name": {
            "value": "not_initialized",
            "default_value": "not_initialized",
            "documentation": "Sets the base name for the application that will be fed to the problem type.",
            "pattern": "0",
            "pattern_description": "[Anything]",
            "actions": "0"
        },
        "dimension": {
            "value": "2",
            "default_value": "2",
            "documentation": "Defines the dimension of the problem",
            "pattern": "1",
            "pattern_description": "[Integer]",
            "actions": "1"
        },
        "number": {
            "value": "double",
            "default_value": "double",
            "documentation": "Floating point number format. Currently, only 'double' is explicitely instantiated.",
            "pattern": "2",
            "pattern_description": "[Selection double ]",
            "actions": "2"
        },
        "global refinements": {
            "value": "1",
            "default_value": "1",
            "documentation": "Defines the number of initial global refinements",
            "pattern": "3",
            "pattern_description": "[Integer]",
            "actions": "3"
        },
        "do print parameters": {
            "value": "true",
            "default_value": "true",
            "documentation": "Set this parameter to true to list parameters in output",
            "pattern": "4",
            "pattern_description": "[Bool]",
            "actions": "4"
        },
        "verbosity level": {
            "value": "1",
            "default_value": "1",
            "documentation": "Sets the verbosity level of the console output: 0: silent: for non-robust tests and benchmark runs; 1: minimal: for robust tests; 2: detailed; 3: full",
            "pattern": "5",
            "pattern_description": "[Integer]",
            "actions": "5"
        },
        "fe": {
            "type": {
                "value": "FE_Q",
                "default_value": "FE_Q",
                "documentation": "Finite Element.FE_Q: hexahedral continuous finite element with polynomial degree p; FE_SimplexP: tetrahedral continuous finite element with polynomial degree p; FE_Q_iso_Q1: hexahedral continuous finite element with p subdivisions containing linear elements; FE_DGQ: hexahedral discontinuous finite element with polynomial degree p",
                "pattern": "6",
                "pattern_description": "[Selection not_initialized|FE_Q|FE_SimplexP|FE_Q_iso_Q1|FE_DGQ ]",
                "actions": "6"
            },
            "degree": {
                "value": "1",
                "default_value": "1",
                "documentation": "Defines the degree p of the finite element type. If \"type\" is \"FE_Q_iso_Q1\" this parameter defines the number of subdivisions.",
                "pattern": "7",
                "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                "actions": "7"
            }
        }
    },
    "time stepping": {
        "start time": {
            "value": "0",
            "default_value": "0",
            "documentation": "Defines the start time for the solution of the levelset problem",
            "pattern": "8",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "8"
        },
        "end time": {
            "value": "1",
            "default_value": "1",
            "documentation": "Sets the end time for the solution of the levelset problem",
            "pattern": "9",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "9"
        },
        "time step size": {
            "value": "0.01",
            "default_value": "0.01",
            "documentation": "Sets the step size for time stepping. For non-uniform time stepping, this parameter determines the size of the first time step.",
            "pattern": "10",
            "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
            "actions": "10"
        },
        "max n steps": {
            "value": "10000000",
            "default_value": "10000000",
            "documentation": "Sets the maximum number of melt_pool steps",
            "pattern": "11",
            "pattern_description": "[Integer]",
            "actions": "11"
        },
        "time step size function": {
            "value": "0.0*t",
            "default_value": "0.0*t",
            "documentation": "Set an analytical function to determine the time step size. For the prediction of the new time increment, the old time is used.",
            "pattern": "12",
            "pattern_description": "[Anything]",
            "actions": "12"
        }
    },
    "narrow band": {
        "type": {
            "value": "extension",
            "default_value": "extension",
            "documentation": "Type of the narrow band. extension: the band consists of the cut cells and their face neighbors; the level set of the neighbor cells is reconstructed by the extension from the cut cells in every time step. advected_layers: the band consists of the cut cells and several layers of vertex neighbors, which are advected together with the cut cells; the level set of the layers is only reconstructed by geometric redistancing (closest point on the discrete interface of the cut cells) for newly added cells and after the elliptic reinitialization of the cut cells. semi_lagrangian: the level set is only stored on the cut cells; in each time step, it is evaluated on the cut cells and their vertex neighbors (candidate cells) by nodal interpolation of the back-traced level set (foot point of the characteristic in a cut cell: polynomial of the cut cell; otherwise: distance to the discrete interface with the sign of the cell containing the foot point). The new cut cells are determined from the candidate cells; no extension is needed. Requires a displacement below one cell per time step.",
            "pattern": "13",
            "pattern_description": "[Selection extension|advected_layers|semi_lagrangian ]",
            "actions": "13"
        },
        "number of layers": {
            "value": "2",
            "default_value": "2",
            "documentation": "Number of layers of vertex neighbors around the cut cells (advected_layers). The interface must move less than one cell per time step (warning with one layer: the interface reaches the outer boundary of the band; with more layers: new cells in the first layer).",
            "pattern": "14",
            "pattern_description": "[Integer range 1...2147483647 (inclusive)]",
            "actions": "14"
        },
        "extension": {
            "type": {
                "value": "ghost_penalty",
                "default_value": "ghost_penalty",
                "documentation": "Type of the extension of the level-set field from the cut cells to the neighbor cells: global face-based ghost-penalty extension (ghost_penalty) or closest-point extension (closest_point), where the level set at the nodes of the neighbor cells is given by the first-order Taylor expansion phi(y) + grad phi(y) . (x - y) from the closest point y on the discrete interface of the cut cells.",
                "pattern": "15",
                "pattern_description": "[Selection ghost_penalty|closest_point ]",
                "actions": "15"
            },
            "ghost penalty parameters": {
                "value": "100, 1",
                "default_value": "100, 1",
                "documentation": "Dimensionless ghost-penalty parameters gamma_k > 0 for the jumps of the k-th normal derivative (k = 0, ..., p) on the ghost-penalty faces, which are scaled by h^(2k+1). Specify comma-separated values starting with k = 0. If less than p+1 values are given, the last value is used for all remaining k.",
                "pattern": "16",
                "pattern_description": "[List of <[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]> of length 0...4294967295 (inclusive)]",
                "actions": "16"
            },
            "ghost penalty faces": {
                "value": "all_band_faces",
                "default_value": "all_band_faces",
                "documentation": "Set of faces on which the ghost-penalty terms of the extension are evaluated (ghost-penalty extension).",
                "pattern": "17",
                "pattern_description": "[Selection all_band_faces|cut_cell_faces ]",
                "actions": "17"
            },
            "sign limiter tolerance": {
                "value": "0.05",
                "default_value": "0.05",
                "documentation": "Tolerance of the sign limiter for the extended level-set field on the neighbor cells, relative to the cell size h. If the extended level set attains values of the opposite sign of its cell mean with a magnitude larger than tolerance * h in a neighbor cell, its deviation from the cell mean is scaled such that it does not change its sign. Neighbor cells do not contain the interface by definition; spurious zero crossings, e.g., due to the polynomial extrapolation near under-resolved interface tips, would otherwise create spurious cut cells. Set to a negative value to disable the limiter.",
                "pattern": "18",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "18"
            },
            "sign clamp epsilon": {
                "value": "0",
                "default_value": "0",
                "documentation": "Sign clamp of the extrapolated level set (extension and geometric redistancing): each extended cell is assigned to the side of the interface, on which it is located (from the traces of the adjacent cut cells or from the closest point on the interface). Nodal values of the opposite sign (or zero) are set to -epsilon * h on the negative side and to +epsilon * h on the positive side (h: cell size), such that extrapolated values never introduce a new interface. The sign clamp is applied after the sign limiter. Set to 0 to disable the sign clamp.",
                "pattern": "19",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "19"
            },
            "minimum source volume fraction": {
                "value": "0",
                "default_value": "0",
                "documentation": "Minimum volume fraction |K cap {phi > 0}| \/ |K| of the positive phase of a cut cell K, for which K serves as source of the extension. Ghost-penalty extension: the ghost-penalty faces between cut cells with a smaller volume fraction and neighbor cells are not evaluated, i.e., the neighbor cells are extended from the other cut cells via the faces to these cut cells and to other neighbor cells (if the ghost-penalty faces include all band faces). If a neighbor cell is not connected to a cut cell with a sufficient volume fraction, its faces to the small cut cells are kept. Closest-point extension: small cut cells are only considered in the closest-point search, if no other cut cells share a vertex with the neighbor cell. In contrast to 'neighbor activation volume fraction', all neighbor cells remain active. Set to 0 to use all cut cells as sources.",
                "pattern": "20",
                "pattern_description": "[Double 0...1 (inclusive)]",
                "actions": "20"
            },
            "redistancing": {
                "value": "taylor_expansion",
                "default_value": "taylor_expansion",
                "documentation": "Geometric redistancing of the cells of the advected band (newly added cells and all cells of the layers after the reinitialization). taylor_expansion: first-order Taylor expansion phi(y) + grad phi(y) . (x - y) from the closest point y on the discrete interface. signed_distance: signed distance s |x - y| with the tracked sign s of the cell, which only changes if the interface passes through the cell; the redistancing never creates an interface, even if the cut cell at the closest point is under-resolved (e.g., at the tip of a thin filament): if the polynomial of a redistanced cell changes its sign, it is shifted such that the minimum of |phi| is 'sign clamp epsilon' * h (if 'sign clamp epsilon' is zero: 1\/10 of the undershoot, such that the modification vanishes with the undershoot). scaled_signed_distance: as signed_distance, but scaled with the gradient magnitude at the closest point, s |grad phi(y)| |x - y| (limited to [1\/2, 2]), i.e., the magnitude of the Taylor expansion, which is consistent with a level set of the cut cells, which is not a signed distance function (e.g., between two reinitializations).",
                "pattern": "21",
                "pattern_description": "[Selection taylor_expansion|signed_distance|scaled_signed_distance ]",
                "actions": "21"
            },
            "layer redistancing": {
                "value": "after_reinitialization",
                "default_value": "after_reinitialization",
                "documentation": "Redistancing of all cells of the layers of the advected band: after each reinitialization of the cut cells (after_reinitialization) or in every time step (every_time_step). The latter allows to reinitialize less often (e.g., 'reinitialization displacement'), while the layers, which provide the inflow data of the cut cells, do not degrade by the inflow condition at the outer boundary of the band.",
                "pattern": "22",
                "pattern_description": "[Selection after_reinitialization|every_time_step ]",
                "actions": "22"
            },
            "cut clipped cells": {
                "value": "false",
                "default_value": "false",
                "documentation": "Advected band with tracked signs (signed_distance, scaled_signed_distance): a cell, which is not cut, but at whose vertices or faces an adjacent cut cell has the other sign (the interface passes through a corner or along a face of the cell, which the discontinuous level set of the cell itself does not resolve), is redistanced by the Taylor expansion from the closest point on the interface of the cut cells, such that it becomes a cut cell. If the quadrature generator finds no interface in it afterwards (e.g., an interface, which is tangent to a face and dips slightly into the cell), it is excluded from the redistancing of the layers in this time step, which would otherwise remove this part of the interface with the tracked sign. Cells cleared by the thin feature removal are excluded, until they are cut again. Recommended for resolved interfaces and high orders; in strongly deformed, under-resolved regions, many cells may be clipped in every time step.",
                "pattern": "23",
                "pattern_description": "[Bool]",
                "actions": "23"
            },
            "linear solver": {
                "solver type": {
                    "value": "CG",
                    "default_value": "CG",
                    "documentation": "Set this parameter for choosing an iterative linear solver type.",
                    "pattern": "24",
                    "pattern_description": "[Selection CG|GMRES ]",
                    "actions": "24"
                },
                "preconditioner type": {
                    "value": "ILU",
                    "default_value": "ILU",
                    "documentation": "Set this parameter for choosing a preconditioner type.",
                    "pattern": "25",
                    "pattern_description": "[Selection Identity|AMG|ILU|Diagonal ]",
                    "actions": "25"
                },
                "max iterations": {
                    "value": "1000",
                    "default_value": "1000",
                    "documentation": "Set the maximum number of iterations for solving the linear system of equations.",
                    "pattern": "26",
                    "pattern_description": "[Integer]",
                    "actions": "26"
                },
                "rel tolerance": {
                    "value": "1e-12",
                    "default_value": "1e-12",
                    "documentation": "Set the relative tolerance for a successful solution of the linear system of equations.",
                    "pattern": "27",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "27"
                },
                "abs tolerance": {
                    "value": "1e-20",
                    "default_value": "1e-20",
                    "documentation": "Set the absolute tolerance for a successful solution of the linear system of equations.",
                    "pattern": "28",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "28"
                },
                "do matrix free": {
                    "value": "false",
                    "default_value": "false",
                    "documentation": "Set this parameter if a matrix free solution procedure should be performed.",
                    "pattern": "29",
                    "pattern_description": "[Bool]",
                    "actions": "29"
                },
                "monitor type": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Set the monitor type of the linear solver.",
                    "pattern": "30",
                    "pattern_description": "[Selection none|reduced|all ]",
                    "actions": "30"
                }
            }
        },
        "thin feature removal": {
            "thickness": {
                "value": "0",
                "default_value": "0",
                "documentation": "Removal of thin features, which cannot be resolved by the mesh (DG advection of the band: types extension and advected_layers). After the advection, a cell K of the band is cleared from a phase, if the thickness 2 |K cap phase| \/ |interface in K| of the phase is below thickness * h (h: cell size) and if two boundaries of the phase in K (branches of the interface or faces, at which the face neighbor has the other sign) of opposite orientation enclose a region of this phase and are closer than thickness * h, or if the phase does not continue into any face neighbor of K (e.g., the remainder of a filament, whose neighboring part has been removed). The part of each face in the phase is determined by a face quadrature. The nodal values of the removed phase are set to the other phase. A cell is not cleared, if a face neighbor would have the other sign in the whole cell afterwards (two face neighbors, which would be cleared to different phases: only the one with the thinner removed phase), since the interface would lie on the shared face. A thin filament thus disappears cell by cell from its tip, once it is thinner than thickness * h, instead of creating spurious interfaces. Set to 0 to disable the removal.",
                "pattern": "31",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "31"
            },
            "epsilon": {
                "value": "0.05",
                "default_value": "0.05",
                "documentation": "Minimum magnitude epsilon * h of the level set in a cleared cell.",
                "pattern": "32",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "32"
            }
        },
        "geometric reconstruction": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Geometric reconstruction of the advected band (type advected_layers), which replaces the elliptic reinitialization, the thin feature removal, the cut clipped cells and the redistancing of the layers: after the advection (and for the initial condition), the level set of all cells of the band is replaced by (1) the signed distance to the discrete interface (zero level sets of the cells and points of the faces, at which the traces of the two cells have opposite signs; the sign is taken from the polynomial of the cell), (2) its morphological opening of both phases with the radius r = thickness * h \/ 2 (erosion by r and dilation by r), which removes all features thinner than thickness * h, and (3) the cell-wise projection onto the polynomials with the penalty term penalty * h * ||phi||^2 on the points of the discrete interface, which survive the opening (|phi| < r \/ 2 after the opening). Changes of the opening below r \/ 2 (rounded corners) are ignored, such that only thin features are removed.",
                "pattern": "33",
                "pattern_description": "[Bool]",
                "actions": "33"
            },
            "thickness": {
                "value": "0.8",
                "default_value": "0.8",
                "documentation": "Thickness relative to the cell size, below which a feature is removed by the morphological opening of the geometric reconstruction.",
                "pattern": "34",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "34"
            },
            "penalty": {
                "value": "100",
                "default_value": "100",
                "documentation": "Penalty gamma of the interface term gamma * h * ||phi||^2 of the cell-wise projection of the geometric reconstruction.",
                "pattern": "35",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "35"
            },
            "displacement": {
                "value": "0",
                "default_value": "0",
                "documentation": "Perform the geometric reconstruction, once the displacement of the interface (sum of max |u| dt) since the last reconstruction reaches this length; zero: in every time step. In the other time steps, the band is only advected.",
                "pattern": "36",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "36"
            }
        },
        "advection": {
            "time integration": {
                "type": {
                    "value": "SSP_RK_stage_3_order_3",
                    "default_value": "SSP_RK_stage_3_order_3",
                    "documentation": "Name of the time integration scheme.",
                    "pattern": "37",
                    "pattern_description": "[Selection not_initialized|LSRK_stage_1_order_1|LSRK_stage_3_order_3|LSRK_stage_5_order_4|LSRK_stage_7_order_4|LSRK_stage_9_order_5|RKC_n_stages|SSP_RK_stage_1_order_1|SSP_RK_stage_2_order_2|SSP_RK_stage_3_order_3|implicit_euler|explicit_euler|crank_nicolson|bdf_1|bdf_2|bdf_3|bdf_4|bdf_5|bdf_6|imex ]",
                    "actions": "37"
                },
                "preconditioner update frequency": {
                    "value": "100",
                    "default_value": "100",
                    "documentation": "Frequency at which the preconditioner gets updated.",
                    "pattern": "38",
                    "pattern_description": "[Integer]",
                    "actions": "38"
                },
                "RKC n stages": {
                    "value": "5",
                    "default_value": "5",
                    "documentation": "Number of stages for the RKC scheme.",
                    "pattern": "39",
                    "pattern_description": "[Integer]",
                    "actions": "39"
                },
                "epsilon": {
                    "value": "0.153846",
                    "default_value": "0.153846",
                    "documentation": "Damping parameter for the RKC scheme.",
                    "pattern": "40",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "40"
                },
                "nlsolve": {
                    "max nonlinear iterations": {
                        "value": "10",
                        "default_value": "10",
                        "documentation": "Set the number of maximum nonlinear iterations with standard tolerances.",
                        "pattern": "41",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "41"
                    },
                    "field correction tolerance": {
                        "value": "1e-10",
                        "default_value": "1e-10",
                        "documentation": "Set the tolerance for the maximum allowed correction of the unknown field.",
                        "pattern": "42",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "42"
                    },
                    "residual tolerance": {
                        "value": "1e-09",
                        "default_value": "1e-09",
                        "documentation": "Set the tolerance for the maximum allowed residual of the nonlinear system.",
                        "pattern": "43",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "43"
                    },
                    "max nonlinear iterations alt": {
                        "value": "0",
                        "default_value": "0",
                        "documentation": "Set the number of maximum nonlinear iterations with alternative tolerances.",
                        "pattern": "44",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "44"
                    },
                    "field correction tolerance alt": {
                        "value": "1e-09",
                        "default_value": "1e-09",
                        "documentation": "Set the alternative tolerance for the maximum allowed correction of the unknown field.",
                        "pattern": "45",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "45"
                    },
                    "residual tolerance alt": {
                        "value": "1e-08",
                        "default_value": "1e-08",
                        "documentation": "Set the alternative tolerance for the maximum allowed residual of the nonlinear system.",
                        "pattern": "46",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "46"
                    },
                    "use relative tolerances": {
                        "value": "false",
                        "default_value": "false",
                        "documentation": "Set to true to interpret the residual tolerances relative to the norm of the initial residual and the field correction tolerances relative to the norm of the current solution. If the respective reference norm is zero, the tolerance is applied as an absolute value.",
                        "pattern": "47",
                        "pattern_description": "[Bool]",
                        "actions": "47"
                    },
                    "verbosity level": {
                        "value": "-1",
                        "default_value": "-1",
                        "documentation": "Set to one for detailed solver output.",
                        "pattern": "48",
                        "pattern_description": "[Integer range -2147483648...2147483647 (inclusive)]",
                        "actions": "48"
                    }
                },
                "linear solver": {
                    "solver type": {
                        "value": "GMRES",
                        "default_value": "GMRES",
                        "documentation": "Set this parameter for choosing an iterative linear solver type.",
                        "pattern": "49",
                        "pattern_description": "[Selection CG|GMRES ]",
                        "actions": "49"
                    },
                    "preconditioner type": {
                        "value": "Identity",
                        "default_value": "Identity",
                        "documentation": "Set this parameter for choosing a preconditioner type.",
                        "pattern": "50",
                        "pattern_description": "[Selection Identity|AMG|ILU|Diagonal ]",
                        "actions": "50"
                    },
                    "max iterations": {
                        "value": "10000",
                        "default_value": "10000",
                        "documentation": "Set the maximum number of iterations for solving the linear system of equations.",
                        "pattern": "51",
                        "pattern_description": "[Integer]",
                        "actions": "51"
                    },
                    "rel tolerance": {
                        "value": "1e-12",
                        "default_value": "1e-12",
                        "documentation": "Set the relative tolerance for a successful solution of the linear system of equations.",
                        "pattern": "52",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "52"
                    },
                    "abs tolerance": {
                        "value": "1e-20",
                        "default_value": "1e-20",
                        "documentation": "Set the absolute tolerance for a successful solution of the linear system of equations.",
                        "pattern": "53",
                        "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                        "actions": "53"
                    },
                    "do matrix free": {
                        "value": "true",
                        "default_value": "true",
                        "documentation": "Set this parameter if a matrix free solution procedure should be performed.",
                        "pattern": "54",
                        "pattern_description": "[Bool]",
                        "actions": "54"
                    },
                    "monitor type": {
                        "value": "none",
                        "default_value": "none",
                        "documentation": "Set the monitor type of the linear solver.",
                        "pattern": "55",
                        "pattern_description": "[Selection none|reduced|all ]",
                        "actions": "55"
                    }
                }
            },
            "velocity": {
                "value": "bulk",
                "default_value": "bulk",
                "documentation": "Velocity of the DG advection on the narrow band: the given velocity u (bulk) or the extension velocity u(y(x)) (extension), i.e., the given velocity at the closest point y(x) = x - phi grad phi \/ |grad phi|^2 on the zero level set, evaluated with the current level set at each stage of the time integration (on faces with the averages of the traces; |grad phi| is bounded from below by 0.5). The extension velocity is constant along the normals of the interface and keeps the level set of the band a signed distance, while the interface moves with u. Not available for the semi-Lagrangian band.",
                "pattern": "56",
                "pattern_description": "[Selection bulk|extension ]",
                "actions": "56"
            },
            "artificial viscosity": {
                "factor": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Artificial viscosity of the advection in the cells flagged by the modal smoothness indicator of Persson & Peraire (2006): the term div(epsilon grad phi) is added to the advection equation (SIPG discretization on the band, natural boundary condition at the outer boundary of the band). The viscosity is constant per cell and determined at the beginning of each time step from the indicator S = log10(E_p \/ E_var), where E_p is the energy of the highest Legendre modes (degree p in any direction) and E_var the energy of all modes except the cell mean: epsilon = epsilon_0 for S > s_0 + kappa, epsilon = epsilon_0 \/ 2 (1 + sin(pi (S - s_0) \/ (2 kappa))) for |S - s_0| <= kappa and zero otherwise, with epsilon_0 = factor h max |u| \/ p (h: cell size, max |u| over the cell) and s_0 = -4 log10(p) + offset. The viscous term is integrated explicitly, i.e., large factors violate the stability limit of the explicit time integration (the maximum diffusion number epsilon dt \/ h^2 is printed for verbosity level 1). A factor of zero disables the artificial viscosity. Requires p >= 2.",
                    "pattern": "57",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "57"
                },
                "indicator offset": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Offset of the threshold s_0 = -4 log10(p) + offset of the smoothness indicator.",
                    "pattern": "58",
                    "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                    "actions": "58"
                },
                "indicator width": {
                    "value": "0.5",
                    "default_value": "0.5",
                    "documentation": "Half width kappa of the transition of the viscosity around the threshold s_0.",
                    "pattern": "59",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "59"
                },
                "cells": {
                    "value": "all_band_cells",
                    "default_value": "all_band_cells",
                    "documentation": "Cells, in which the artificial viscosity is applied: all cells of the band (all_band_cells) or all cells of the band, which are not cut at the beginning of the time step (non_cut_cells).",
                    "pattern": "60",
                    "pattern_description": "[Selection all_band_cells|non_cut_cells ]",
                    "actions": "60"
                }
            },
            "limiter": {
                "cells": {
                    "value": "none",
                    "default_value": "none",
                    "documentation": "Bound-preserving limiter of the advection: after each stage of the SSP Runge-Kutta scheme, the level set of the limited cells is scaled around its cell mean, such that its values at the Gauss-Lobatto points remain within the bounds given by the minimum m and maximum M of the level set at the beginning of the time step on the domain of dependence of the cell. none: no limiter; all_band_cells: all cells of the band; non_cut_cells: all cells of the band, which are not cut at the beginning of the time step.",
                    "pattern": "61",
                    "pattern_description": "[Selection none|all_band_cells|non_cut_cells ]",
                    "actions": "61"
                },
                "type": {
                    "value": "sign",
                    "default_value": "sign",
                    "documentation": "Type of the bounds. maximum_principle: local maximum principle [m - r h, M + r h]; cells with an inflow face to an inactive cell or at the boundary of the domain are not limited (unknown domain of dependence). sign: cells, whose domain of dependence has a definite sign, keep this sign, i.e., phi >= min(m, epsilon h) if m > 0 and phi <= max(M, -epsilon h) if M < 0; cells with values of both signs in their domain of dependence are not limited; inactive cells and the boundary of the domain have the sign of the adjacent band cell. In contrast to the sign preservation, the local maximum principle also clips smooth extrema of the level set (e.g., the ridge of a thin filament).",
                    "pattern": "62",
                    "pattern_description": "[Selection maximum_principle|sign ]",
                    "actions": "62"
                },
                "bounds": {
                    "value": "upwind_strips",
                    "default_value": "upwind_strips",
                    "documentation": "Approximation of the domain of dependence of a cell: the cell and all its face neighbors in the band (face_neighbors), the cell and its face neighbors in the band across inflow faces (upwind_face_neighbors), or the cell and the strips of width |u.n| dt of the face neighbors in the band along the inflow faces, which are extended by |u| dt beyond the edges of the faces (upwind_strips).",
                    "pattern": "63",
                    "pattern_description": "[Selection face_neighbors|upwind_face_neighbors|upwind_strips ]",
                    "actions": "63"
                },
                "relaxation": {
                    "value": "0",
                    "default_value": "0",
                    "documentation": "Relaxation r of the bounds of the local maximum principle relative to the cell size h: [m - r h, M + r h].",
                    "pattern": "64",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "64"
                },
                "sign epsilon": {
                    "value": "0.01",
                    "default_value": "0.01",
                    "documentation": "Minimum distance epsilon h of the level set from zero (relative to the cell size h), which is enforced by the sign-preserving limiter, unless the domain of dependence attains values closer to zero.",
                    "pattern": "65",
                    "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                    "actions": "65"
                }
            }
        },
        "neighbor activation": {
            "value": "all_face_neighbors",
            "default_value": "all_face_neighbors",
            "documentation": "Face neighbors of the cut cells, which are activated as neighbor cells of the band (extension band). all_face_neighbors: all face neighbors; downstream_face_neighbors: only the face neighbors, into which the velocity points across a face shared with a cut cell (at any Gauss-Lobatto point of the face at the beginning or the end of the next time step), i.e., the cells into which the interface can move. The level set is only extended to these cells. At the faces of the cut cells to inactive upstream cells, the upwind flux uses the interior trace of the cut cell, i.e., the cut cell is not influenced by extrapolated values from upstream.",
            "pattern": "66",
            "pattern_description": "[Selection all_face_neighbors|downstream_face_neighbors ]",
            "actions": "66"
        },
        "neighbor activation volume fraction": {
            "value": "0",
            "default_value": "0",
            "documentation": "Minimum volume fraction |K cap {phi > 0}| \/ |K| of the positive phase of a cut cell K, for which its face neighbors are activated as neighbor cells of the narrow band (and filled by the extension). Face neighbors of cut cells with a smaller volume fraction remain inactive (FE_Nothing), unless they are face neighbors of another cut cell with a sufficient volume fraction. Set to 0 to activate all face neighbors of the cut cells.",
            "pattern": "67",
            "pattern_description": "[Double 0...1 (inclusive)]",
            "actions": "67"
        },
        "reinitialization faces": {
            "value": "cut_cell_faces",
            "default_value": "cut_cell_faces",
            "documentation": "Set of faces on which the SIPG terms of the elliptic reinitialization on the cut cells are evaluated: all faces between two cut cells (cut_cell_faces) or only the faces between two cut cells, which are crossed by the interface (interface_faces). In the latter case, the cut cells are only coupled across the faces crossed by the interface.",
            "pattern": "68",
            "pattern_description": "[Selection cut_cell_faces|interface_faces ]",
            "actions": "68"
        },
        "level set space": {
            "value": "discontinuous",
            "default_value": "discontinuous",
            "documentation": "Finite element space of the level set on the cut cells of the semi-Lagrangian band: discontinuous (FE_DGQ) or continuous (FE_Q of the same degree, continuous across the faces between cut cells). For the continuous space, the reinitialization (fixed-point iteration without face terms, direct solver) and the subcell distance (L2-projection on the union of the unresolved cells with natural boundary conditions, or nodal interpolation) are computed in the continuous space; the semi-Lagrangian step maps a continuous level set to a continuous level set. The subcell coupling excluded is not available for the continuous space.",
            "pattern": "69",
            "pattern_description": "[Selection discontinuous|continuous ]",
            "actions": "69"
        },
        "closed interface correction": {
            "value": "true",
            "default_value": "true",
            "documentation": "Continuous level set space: correction of the level set after each time step (after the reinitialization and the subcell distance, and after the initial reinitialization), such that the zero level set is closed: on each face between a cut cell and a cell, which is not cut (excluding the boundary of the domain), the level set has the sign s of the neighbor cell. The minimum of s phi on a face is computed with the Bernstein coefficients of the restriction of the level set to the face and de Casteljau subdivision (any polynomial degree); faces, on which the interface only touches the face, are not changed. Where the interface crosses a face, the cell behind the face is added to the cut cells (closed interface activation; the nodes of the face keep their values, the other nodes of the cell take the values of the semi-Lagrangian step), since the reinitialization has moved the interface into this cell. On the remaining faces, all nodal values of the face are shifted by s (c h - m) (m: minimum of s phi on the face, c: closed interface offset), i.e., the interface is moved back into the cut cell. Thus, the interface only ends at the boundary of the domain. Not used for the discontinuous space.",
            "pattern": "70",
            "pattern_description": "[Bool]",
            "actions": "70"
        },
        "closed interface activation": {
            "value": "true",
            "default_value": "true",
            "documentation": "Closed-interface correction: add the cells, which are not cut, behind faces crossed by the interface to the cut cells (instead of moving the interface back into the cut cell). Without the activation, the correction pushes the interface back, when the reinitialization moves it towards the points into a cell, which the advected level set does not cut, which delays the interface and accumulates errors for small time steps.",
            "pattern": "71",
            "pattern_description": "[Bool]",
            "actions": "71"
        },
        "closed interface offset": {
            "value": "0.01",
            "default_value": "0.01",
            "documentation": "Closed-interface correction: minimum c of s phi on a lifted face relative to the cell size (distance of the corrected interface from the face).",
            "pattern": "72",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "72"
        },
        "level set update cfl": {
            "value": "0",
            "default_value": "0",
            "documentation": "Semi-Lagrangian band: sub-cycling of the level-set update for small time steps. If positive, the level set of a time step is evaluated from the last reference level set at the foot points of the nodes at the time of the reference (backward integration of the characteristics over all time steps since the reference or characteristic map, see 'level set update characteristics'), i.e., without accumulating the interpolation errors of the intermediate time steps; these level sets are only corrected by the closed-interface correction. The reinitialization, the insertion of new interface points and the update of the reference are performed, once the maximum displacement of the nodes since the reference exceeds this value times the cell size (the reinitialization frequency then counts these updates). Thus, the number of these operations, whose errors accumulate, does not grow with the number of time steps. Recommended: 0.5 (at most 0.9, since the interface must not leave the candidate cells of the reference). Zero: update in every time step.",
            "pattern": "73",
            "pattern_description": "[Double 0...0.9 (inclusive)]",
            "actions": "73"
        },
        "level set update characteristics": {
            "value": "integration",
            "default_value": "integration",
            "documentation": "Sub-cycling of the level-set update (level set update cfl > 0): computation of the foot points of the nodes at the time of the reference. integration: backward integration of the characteristics from the current time to the time of the reference (one fourth-order Runge-Kutta step per time step since the reference), which requires the velocity at all these times. map: characteristic map, i.e., the displacement D(x) = x - X(t_ref; x, t) of the nodes since the reference is stored as a continuous (FE_Q) field on the candidate cells of the reference and composed in each time step with the backward characteristic of the time step, D^{n+1}(x) = x - y + D^n(y) with y = X(t^n; x, t^{n+1}) (one fourth-order Runge-Kutta step), which only requires the velocity of the current time step. The interpolation error of D^n at y is proportional to the displacement of the time step, i.e., it does not accumulate with the number of time steps.",
            "pattern": "74",
            "pattern_description": "[Selection integration|map ]",
            "actions": "74"
        },
        "reinitialization interface": {
            "value": "zero_level_set",
            "default_value": "zero_level_set",
            "documentation": "Interface, at which the reinitialization on the cut cells enforces phi = 0 weakly by the interface penalty term: the zero level set of the level set before the reinitialization (zero_level_set) or points of the interface (advected_points), which are seeded on the initial zero level set (Gauss points of the surface quadrature) and advected with the velocity (classical fourth-order Runge-Kutta method, weights and normal vectors by Nanson's formula) independently of the interpolation of the level set (front tracking). Points outside of the band or with |phi| > 0.2 h are removed, the quadrature points of the zero level set of the level set at the end of the time step (or of the advected level set phi, see 'point insertion'), whose distance to all points exceeds h \/ n, are added, and in cells with more than 2 n^(dim-1) points, the closest points are merged (n Gauss points per direction, default p + 1). Points with a point of opposite orientation closer than 2 h (under-resolved interface) are not used. The cut cells are determined from phi; in cut cells without usable points, the zero level set of phi is used. The factors 0.2 and 2 and the number n are set in the subsection 'advected points'.",
            "pattern": "75",
            "pattern_description": "[Selection zero_level_set|advected_points ]",
            "actions": "75"
        },
        "reinitialization frequency": {
            "value": "1",
            "default_value": "1",
            "documentation": "Reinitialize the level-set field on the cut cells every n-th time step. Set to 0 to disable the frequency-based reinitialization.",
            "pattern": "76",
            "pattern_description": "[Integer]",
            "actions": "76"
        },
        "reinitialization eikonal threshold": {
            "value": "0",
            "default_value": "0",
            "documentation": "Reinitialize the level-set field on the cut cells, if the eikonal error sqrt(int (|grad phi| - 1)^2 dx \/ V) on the cut cells exceeds this value. Set to 0 to disable the error-based reinitialization.",
            "pattern": "77",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "77"
        },
        "reinitialization displacement": {
            "value": "0",
            "default_value": "0",
            "documentation": "Reinitialize the level-set field on the cut cells, once the displacement of the interface since the last reinitialization, estimated by the sum of max |u| dt over the time steps (maximum of the velocity on the band at the beginning of the time step), reaches this length (absolute length, not relative to the cell size). The number of reinitializations then depends on the distance travelled by the interface, but neither on the time step size nor on the cell size. Combined with 'reinitialization frequency' and 'reinitialization eikonal threshold' (a reinitialization is performed, if any criterion holds); set 'reinitialization frequency' to 0 to use this criterion only. For the advected band, combine it with 'extension\/layer redistancing = every_time_step'. Set to 0 to disable the displacement-based reinitialization.",
            "pattern": "78",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "78"
        },
        "advected points": {
            "unresolved distance": {
                "value": "2",
                "default_value": "2",
                "documentation": "Distance relative to the cell size, below which advected interface points of opposite orientation are not used in the reinitialization (unresolved interface, e.g., both sides of a thin filament); the treatment of the cells around them is set by 'unresolved cells'. Only used for reinitialization interface = advected_points.",
                "pattern": "79",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "79"
            },
            "support tolerance": {
                "value": "0.2",
                "default_value": "0.2",
                "documentation": "Advected interface points, at which the magnitude of the advected level set exceeds this value times the cell size, are removed (parts of the interface, which the level set has lost). Only used for reinitialization interface = advected_points.",
                "pattern": "80",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "80"
            },
            "merge distance": {
                "value": "0.05",
                "default_value": "0.05",
                "documentation": "Merge distance c_m relative to the cell size of the merge and break-up rules for topology changes. Merge rule (e.g., merging droplets): with the approach a = dt max(0, (u(x - h n) - u(x)) . n) of the flow on the outer side of an advected interface point within one time step, a point in a converging flow (the positive part of the normal velocity difference (u(x - h n) - u(x)) . n exceeds a quarter of the magnitude |u(x - h n) - u(x)| of the velocity difference, independent of a superposed uniform translation) is removed, if the advected level set at the distance c_m h + a on the outer side of the point (opposite to its normal vector) exceeds the value at the point by more than a quarter of this distance (the point lies inside of the phase or at a gap thinner than about c_m h + a), or if a point of a different orientation (n_i . n_j < 1\/2) is closer than the sum of the approaches of the two points and each of them lies on the outer side of the other one (the gap has closed within the time step). Break-up rule (e.g., a neck, which pinches off): the same on the inner side of the point (in the direction of its normal vector; the point is removed, if the level set on the inner side is smaller than the value at the point by more than a quarter of the distance, or if a point of a different orientation within the sum of the approaches lies on the inner side, face to face); in addition, the points, which have crossed a line of converging characteristics within the time step (the velocity changes along the path by D = u(x^n, t^n) - u(x^{n+1}, t^{n+1}), and the velocity at x^{n+1} - dt D differs from the velocity at the new position by more than |D| \/ 2), are removed (e.g., the two sides of a tip, which are squeezed together). The points move forward in time and cannot represent the disappearance of colliding parts of the interface, while the advected level set (backward characteristics) already contains the merged or broken-up interface. Wider gaps, thicker parts of the phase and thin filaments in shear or rotating flows are kept. Zero disables both rules. Only used for reinitialization interface = advected_points.",
                "pattern": "81",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "81"
            },
            "points per direction": {
                "value": "0",
                "default_value": "0",
                "documentation": "Number n of Gauss points per direction of the surface quadrature, at which the advected interface points are seeded on the initial zero level set and inserted into gaps of the point set (0: n = p + 1, i.e., p + 1 points per cut cell in 2D and (p + 1)^2 in 3D). It also sets the minimum distance h \/ n of an inserted point to all points and the maximum number 2 n^(dim-1) of points per cell, above which the closest points are merged. More points cover small pieces of the interface in the cut cells (fewer cut cells, whose penalty term falls back to the zero level set of the advected level set), pin the zero level set more tightly between the points and shorten the patches of the subcell distance, at a cost proportional to n^(dim-1). Only used for reinitialization interface = advected_points.",
                "pattern": "82",
                "pattern_description": "[Integer]",
                "actions": "82"
            },
            "point insertion": {
                "value": "final_level_set",
                "default_value": "final_level_set",
                "documentation": "Level set, from whose zero level set new advected interface points are inserted into the gaps of the point set (Gauss points farther than h \/ n from all points): the advected level set before the reinitialization (advected_level_set) or the level set at the end of the time step, i.e., after the reinitialization, the subcell distance and the closed-interface correction (final_level_set). In the latter case, the new points lie on the corrected interface, and the reinitialization of the time step uses the zero level set of the advected level set in the cut cells without usable points. Only used for reinitialization interface = advected_points.",
                "pattern": "83",
                "pattern_description": "[Selection advected_level_set|final_level_set ]",
                "actions": "83"
            },
            "conservative insertion": {
                "value": "true",
                "default_value": "true",
                "documentation": "If false, a new advected interface point is added with the weight of its quadrature point. Since the weights of the existing points grow with the stretching of the interface (Nanson's formula), they already contain the area of the gap, in which the new point is inserted, and this area is counted twice. If true, the weights of all points of a cell with new points are scaled by W \/ (W + W*) with the sums W and W* of the weights of the existing and the new points of the cell, i.e., the sum of the weights of the cell is conserved; in cells without existing points (e.g., cells emptied by the merge or break-up rules), the new points keep their weights. The sum of the weights then approximates the area of the interface. The weights enter the penalty term of the reinitialization and the size of the patches of the subcell distance. Only used for reinitialization interface = advected_points.",
                "pattern": "84",
                "pattern_description": "[Bool]",
                "actions": "84"
            },
            "unresolved cells": {
                "value": "zero_level_set",
                "default_value": "zero_level_set",
                "documentation": "Treatment of the cut cells, which contain unresolved points or are closer than 'subcell buffer' times the cell size to an unresolved point. zero_level_set: the reinitialization uses the zero level set of the advected level set in the cut cells without usable points (and only the usable points in the other cut cells). subcell_distance: the level set of these cells is given by the L2-projection of the signed distance to the advected points (all points, evaluated at the points of an iterated Gauss quadrature with 'subcell subdivisions' subdivisions per direction; each point represents a flat patch of its weight with its normal vector), i.e., the reinitialization of these cells is replaced by an exact redistancing at the subcell scale, whose result is projected onto the polynomials of the cells. Beyond the edges of the patches (e.g., the open end of a chain of points), the signed distance takes the sign of the advected level set, and a cell keeps the reinitialized level set, if the signed distance has a different sign than the advected level set at a quadrature point farther than a quarter of the cell size from the points (the points do not create new parts of the interface); the coupling to the reinitialization of the other cut cells is set by 'subcell coupling' and the nodal interpolation instead of the projection by 'subcell transfer'. Only used for reinitialization interface = advected_points.",
                "pattern": "85",
                "pattern_description": "[Selection zero_level_set|subcell_distance ]",
                "actions": "85"
            },
            "subcell buffer": {
                "value": "1",
                "default_value": "1",
                "documentation": "Distance relative to the cell size, within which the cut cells around unresolved points are treated as unresolved cells.",
                "pattern": "86",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "86"
            },
            "subcell subdivisions": {
                "value": "4",
                "default_value": "4",
                "documentation": "Number of subdivisions per direction of the iterated Gauss quadrature of the L2-projection of the subcell distance and of the sign check.",
                "pattern": "87",
                "pattern_description": "[Integer range 1...2147483647 (inclusive)]",
                "actions": "87"
            },
            "subcell coupling": {
                "value": "overwrite",
                "default_value": "overwrite",
                "documentation": "Coupling of the cells of the subcell distance to the reinitialization of the other cut cells. overwrite: the projection replaces the reinitialized level set in these cells after the reinitialization (the reinitialization is solved on all cut cells, and the level set may jump at the faces between projected and reinitialized cells). prescribed: the projection is computed before the reinitialization, which keeps it as prescribed values in these cells, i.e., only the other cut cells are reinitialized, and they are coupled to the projected cells by the SIPG face terms (weak Dirichlet data). excluded: as prescribed, but without the face terms between projected and reinitialized cells (natural boundary condition of the reinitialized cells at these faces). With prescribed and excluded, the reinitialization does not contain the conflicting terms of the unresolved cells and needs considerably fewer fixed-point iterations; with prescribed, errors of the projection (e.g., remnants at the tips of filaments) can spread into the adjacent cells.",
                "pattern": "88",
                "pattern_description": "[Selection overwrite|prescribed|excluded ]",
                "actions": "88"
            },
            "subcell transfer": {
                "value": "projection",
                "default_value": "projection",
                "documentation": "Representation of the signed distance to the advected points in the finite element space of the unresolved cells. projection: L2-projection of the signed distance evaluated at the points of the iterated Gauss quadrature with 'subcell subdivisions' subdivisions per direction, which resolves the kink of the distance on the medial axis of a thin filament inside the cells (best approximation by the polynomials of the cells). interpolation: nodal interpolation, i.e., the signed distance is only evaluated at the nodes of the cells (no linear system; the quadrature points are still used for the sign check). The interpolation samples the kink of the distance only at the nodes, which places the zeros of thin filaments less accurately and loses thin filaments already at larger widths than the projection, depending on their position relative to the nodes. Only available for the continuous level set space.",
                "pattern": "89",
                "pattern_description": "[Selection projection|interpolation ]",
                "actions": "89"
            },
            "subcell orientation filter": {
                "value": "false",
                "default_value": "false",
                "documentation": "If true, the subcell distance of a cell, whose points all have the same orientation (pairwise n_i . n_j > 0), is only computed to the points of this orientation, i.e., to the branch of the interface in this cell, and not to a close branch of opposite orientation in a neighbor cell (e.g., the other side of a narrow gap or of a thin filament, whose sides lie in different cells). The kink of the distance on the medial axis then lies on the face between the cells (jump of the level set) instead of inside a cell, where the polynomials cannot represent it. Cells with points of both orientations (e.g., a thin filament inside the cell) or without points use all points. Only recommended for interfaces at rest (e.g., close particles): for advected interfaces, the semi-Lagrangian step evaluates the polynomials of the cells anywhere in the cells, where the distance to one branch overestimates the magnitude of the level set between the branches, so that thin filaments and gaps widen.",
                "pattern": "90",
                "pattern_description": "[Bool]",
                "actions": "90"
            },
            "subcell pinning penalty": {
                "value": "0",
                "default_value": "0",
                "documentation": "Dimensionless penalty parameter c of the pinned subcell projection (zero: plain L2-projection). In a projected cell, whose points all have the same orientation (one branch of the interface in the cell), the projection minimizes the L2-error to the signed distance to all points plus c h sum_k w_k phi(x_k)^2 over the points x_k of the cell with the weights w_k. The penalty keeps the zero level set of the cell on its points, while the distance to a close branch of opposite orientation in a neighbor cell (e.g., the other side of a narrow gap) still determines the level set away from the points: the kink of the distance on the medial axis only perturbs the level set away from the interface. Cells with points of both orientations are not pinned (the polynomials may not vanish at the points of both branches). Recommended for interfaces at rest or weakly deformed interfaces (e.g., close particles): for strongly stretched thin filaments, the penalty also keeps fragments of filaments, which the L2-projection would remove, so that small droplets and wiggles remain.",
                "pattern": "91",
                "pattern_description": "[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]",
                "actions": "91"
            }
        },
        "continuous level set": {
            "enable": {
                "value": "false",
                "default_value": "false",
                "documentation": "Compute a continuous level-set field psi on the cut cells (FE_Q of the same degree, continuous across the faces between cut cells) after each time step by the constrained L2-projection of the DG level set phi: (psi, w) + sum_K gamma_K (psi, w)_{Gamma cap K} = (phi, w) on the cut cells, where Gamma is the zero level set of phi. The normal vector (projection of grad psi, normalized at the nodes) and the curvature (projection of -div n) are computed from psi with the filter parameters and linear solvers of the subsections 'normal vector' and 'curvature'. A filter parameter of zero is recommended: the damping biases the normal vector and the curvature on the thin band of cut cells independently of the mesh size. The fields are written to the output as level_set_cg, normal and curvature. The continuous level set does not feed back into the DG level set.",
                "pattern": "92",
                "pattern_description": "[Bool]",
                "actions": "92"
            },
            "interface penalty": {
                "value": "100",
                "default_value": "100",
                "documentation": "Dimensionless factor c of the interface penalty gamma_K = c h_K (h_K: cell size), which pins the zero level set of the continuous level set to the zero level set of the DG level set in a least-squares sense. Since the DG level set is discontinuous, the interface may still move; the maximum shift is printed for verbosity level 1. Set to 0 for the plain L2-projection.",
                "pattern": "93",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "93"
            },
            "sign constraints": {
                "value": "false",
                "default_value": "false",
                "documentation": "Enforce the signs of the cells, which are not cut, on the continuous level set, such that its zero level set does not leave the cut cells (it may otherwise cut the corner of a neighboring cell, where the continuous level set is not defined, if the DG level set jumps near a vertex of the band boundary). If the continuous level set has the wrong sign (or zero) at a node or between the nodes (checked at 4p+1 points per direction) of a face, edge or vertex shared with a cell, which is not cut, all nodal values of this face, edge or vertex are constrained to their values with the sign s of this cell and at least the magnitude c h (c: 'sign constraint offset'; the interior nodal values are raised further, if the sign still changes between the nodes), and the projection is repeated (at most five times). The numbers of constrained nodal values and of projections are printed for verbosity level 1. Requires narrow band\/type = semi_lagrangian.",
                "pattern": "94",
                "pattern_description": "[Bool]",
                "actions": "94"
            },
            "sign constraint offset": {
                "value": "0.01",
                "default_value": "0.01",
                "documentation": "Magnitude c of the constrained nodal values s c h of the sign constraints relative to the cell size h.",
                "pattern": "95",
                "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
                "actions": "95"
            },
