        "neighbor activation volume fraction": {
            "value": "0",
            "default_value": "0",
            "documentation": "Minimum volume fraction |K cap {phi > 0}| \/ |K| of the positive phase of a cut cell K, for which its face neighbors are activated as neighbor cells of the narrow band (and filled by the extension). Face neighbors of cut cells with a smaller volume fraction remain inactive (FE_Nothing), unless they are face neighbors of another cut cell with a sufficient volume fraction. Set to 0 to activate all face neighbors of the cut cells.",
            "pattern": "44",
            "pattern_description": "[Double 0...1 (inclusive)]",
            "actions": "44"
        },
        "reinitialization faces": {
            "value": "cut_cell_faces",
            "default_value": "cut_cell_faces",
            "documentation": "Set of faces on which the SIPG terms of the elliptic reinitialization on the cut cells are evaluated: all faces between two cut cells (cut_cell_faces) or only the faces between two cut cells, which are crossed by the interface (interface_faces). In the latter case, the cut cells are only coupled across the faces crossed by the interface.",
            "pattern": "45",
            "pattern_description": "[Selection cut_cell_faces|interface_faces ]",
            "actions": "45"
        },
        "reinitialization frequency": {
            "value": "1",
            "default_value": "1",
            "documentation": "Reinitialize the level-set field on the cut cells every n-th time step. Set to 0 to disable the frequency-based reinitialization.",
            "pattern": "46",
            "pattern_description": "[Integer]",
            "actions": "46"
        },
        "reinitialization eikonal threshold": {
            "value": "0",
            "default_value": "0",
            "documentation": "Reinitialize the level-set field on the cut cells, if the eikonal error sqrt(int (|grad phi| - 1)^2 dx \/ V) on the cut cells exceeds this value. Set to 0 to disable the error-based reinitialization.",
            "pattern": "47",
            "pattern_description": "[Double 0...MAX_DOUBLE (inclusive)]",
            "actions": "47"
        }
    },
