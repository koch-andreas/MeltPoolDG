{
  "$schema": "../../../parameters.schema.json",
  "base": {
    "case name": "vortex_bubble",
    "dimension": 2,
    "global refinements": 4,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 0
  },
  "case specific": {
    "center point": "0.5, 0.75",
    "radius": 0.15,
    "T": 0.5
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.5,
    "time step size": 0.01
  },
  "output": {
    "do user defined postprocessing": true,
    "write frequency": 10,
    "paraview": {
      "enable": false
    }
  },
  "narrow band": {
    "type": "semi_lagrangian",
    "reinitialization frequency": 2
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "ILU",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000.0,
      "nlsolve": {
        "max nonlinear iterations": 50,
        "residual tolerance": 1e-05,
        "field correction tolerance": 1e-05,
        "verbosity level": 0
      }
    }
  }
}
