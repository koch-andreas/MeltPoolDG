{
  "base": {
    "case name": "vortex_bubble",
    "dimension": 2,
    "global refinements": 7,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 1
  },
  "case specific": {
    "center point": "0.5, 0.75",
    "radius": 0.15,
    "T": 8
  },
  "time stepping": {
    "start time": 0,
    "end time": 8,
    "time step size": 0.005
  },
  "output": {
    "directory": "out_nb_T6_r6",
    "do user defined postprocessing": true,
    "write frequency": 100,
    "paraview": {
      "enable": true,
      "filename": "solution",
      "n patches": 6
    }
  },
  "narrow band": {
    "type": "semi_lagrangian",
    "reinitialization frequency": 2,
    "reinitialization faces": "interface_faces",
    "continuous level set": {
      "enable": false,
      "sign constraint": true,
      "linear solver": {
        "solver type": "CG",
        "preconditioner type": "ILU",
        "max iterations": 1000,
        "rel tolerance": 1e-08,
        "abs tolerance": 1e-09,
        "do matrix free": true
      }
    },
    "reinitialization interface": "advected_points",
    "advected points": {
      "unresolved cells": "subcell_distance",
      "subdivision subdivisions": 4,
      "subdivision buffer": 0.4
    }
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "Diagonal",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000,
      "nlsolve": {
        "max nonlinear iterations": 1000,
        "residual tolerance": 1e-05,
        "field correction tolerance": 1e-05,
        "verbosity level": 0
      }
    }
  }
}
