{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "static_particles",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 1
  },
  "case specific": {
    "domain min": "0, 0",
    "domain max": "1, 0.5",
    "cell repetitions": "2, 1",
    "distortion factor": 0.8,
    "initial condition": "cellwise",
    "powder bed": {
      "particle list file": "applications/mp-narrow-band/cases/static_particles/particle_rows_2d.csv",
      "slice location": 0.0
    }
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 20.0,
    "time step size": 1.0
  },
  "output": {
    "directory": "output_static_particles",
    "do user defined postprocessing": true,
    "write frequency": 1,
    "paraview": {
      "enable": true,
      "n patches": 6
    }
  },
  "narrow band": {
    "type": "semi_lagrangian",
    "reinitialization frequency": 1,
    "reinitialization faces": "interface_faces",
    "continuous level set": {
      "enable": true,
      "linear solver": {
        "abs tolerance": 1e-14,
        "max iterations": 2000
      }
    }
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "ILU",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000.0,
      "nlsolve": {
        "max nonlinear iterations": 1000,
        "residual tolerance": 1e-05,
        "field correction tolerance": 1e-05,
        "verbosity level": 0
      }
    }
  }
}