{
  "$schema": "../../../parameters.schema.json",
  "base": {
    "case name": "static_circle",
    "dimension": 2,
    "global refinements": 4,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 0
  },
  "case specific": {
    "center point": "0.031, -0.027, 0.019",
    "radius": 0.5,
    "distortion point": "0.7, 0.7, 0.7",
    "distortion offset": 0.1,
    "reinitialize initial condition": true
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.02,
    "time step size": 0.01
  },
  "output": {
    "do user defined postprocessing": true,
    "write frequency": 1,
    "paraview": {
      "enable": false
    }
  },
  "narrow band": {
    "type": "semi_lagrangian",
    "level set space": "continuous",
    "reinitialization frequency": 1,
    "reinitialization interface": "advected_points",
    "advected points": {
      "unresolved cells": "subcell_distance",
      "subcell coupling": "prescribed"
    },
    "continuous level set": {
      "enable": true
    }
  },
  "curvature": {
    "enable": true
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "ILU",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000.0,
      "nlsolve": {
        "max nonlinear iterations": 1000,
        "residual tolerance": 1e-10,
        "field correction tolerance": 1e-10,
        "verbosity level": 0
      }
    }
  }
}
