{
  "$schema": "../../../parameters.schema.json",
  "base": {
    "case name": "rotating_circle",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 0
  },
  "case specific": {
    "center point": "0., 0.5",
    "radius": 0.25,
    "rotation center": "0., 0.",
    "angular velocity": 6.283185307179586
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.02,
    "time step size": 0.001
  },
  "output": {
    "do user defined postprocessing": true,
    "write frequency": 10,
    "paraview": {
      "enable": false
    }
  },
  "narrow band": {
    "extension": {
      "ghost penalty parameters": "100., 1.",
      "ghost penalty faces": "all_band_faces",
      "linear solver": {
        "solver type": "CG",
        "preconditioner type": "ILU",
        "rel tolerance": 1e-12,
        "do matrix free": false
      }
    },
    "advection": {
      "time integration": {
        "type": "SSP_RK_stage_3_order_3"
      }
    },
    "reinitialization frequency": 10
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "ILU",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000.0,
      "nlsolve": {
        "max nonlinear iterations": 50,
        "residual tolerance": 1e-05,
        "field correction tolerance": 1e-05,
        "verbosity level": 0
      }
    }
  }
}
