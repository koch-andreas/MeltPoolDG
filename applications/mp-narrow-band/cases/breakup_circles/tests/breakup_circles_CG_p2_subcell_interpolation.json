{
  "$schema": "../../../parameters.schema.json",
  "base": {
    "case name": "breakup_circles",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "fe": {
      "degree": 2,
      "type": "FE_DGQ"
    },
    "verbosity level": 0
  },
  "case specific": {
    "center point": "0.013, 0.",
    "radius": 0.24,
    "distance": 0.46,
    "velocity": 0.25
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.5,
    "time step size": 0.01
  },
  "output": {
    "do user defined postprocessing": true,
    "write frequency": 10,
    "paraview": {
      "enable": false
    }
  },
  "narrow band": {
    "type": "semi_lagrangian",
    "reinitialization frequency": 1,
    "level set space": "continuous",
    "closed interface correction": true,
    "reinitialization faces": "interface_faces",
    "reinitialization interface": "advected_points",
    "advected points": {
      "unresolved cells": "subcell_distance",
      "subcell subdivisions": 4,
      "subcell coupling": "prescribed",
      "subcell transfer": "interpolation",
      "points per direction": 3
    }
  },
  "reinitialization": {
    "type": "elliptic",
    "linear solver": {
      "solver type": "CG",
      "preconditioner type": "Diagonal",
      "max iterations": 1000,
      "rel tolerance": 1e-08,
      "abs tolerance": 1e-20,
      "do matrix free": true
    },
    "elliptic": {
      "intersected cells only": true,
      "penalty parameter": 10000,
      "nlsolve": {
        "max nonlinear iterations": 1000,
        "residual tolerance": 1e-05,
        "field correction tolerance": 1e-05,
        "verbosity level": 0
      }
    }
  }
}
